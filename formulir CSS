* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f0fff8;
    color: #575092;
    line-height: 1.6;
}

header {
    background-color: #00ab03;
    color: white;
    text-align: center;
    padding: 30px 20px;
}

header h1 {
    font-size: 36px;
    margin-bottom: 5px;
}

header p {
    color: white;
}

nav {
    background-color: #0e5c16;
    text-align: center;
    padding: 10px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
}

nav a:hover {
    text-decoration: underline;
}

main {
    max-width: 600px;
    margin: 30px auto;
    padding: 0 20px;
    text-align: center;
}

h2 {
    color: #138b13;
    margin-bottom: 10px;
    text-align: center;
}

.item-ulasan {
    background-color: white;
    padding: 15px;
    margin-top: 15px;
    border-radius: 8px;
    box-shadow: 0 2px 7px rgba(0, 0, 0, 0.1);
}

.item-ulasan h3 {
    color: #138b13;
}

.meta-ulasan {
    font-size: 13px;
    color: #777;
    margin-bottom: 8px;
}

.isi-ulasan {
    overflow-wrap: anywhere;
    margin-bottom: 8px;
}

.pesan {
    text-align: center;
    margin-top: 15px;
    font-weight: bold;
}

.pesan.sukses {
    color: green;
}

.pesan.error {
    color: red;
}

.kosong {
    text-align: center;
    margin-top: 15px;
}

.kembali {
    margin-top: 20px;
}

.kembali a {
    color: #138b13;
}

footer {
    background-color: #285c0e;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 30px;
}

@media (max-width: 768px) {
    header h1 {
        font-size: 30px;
    }
}
